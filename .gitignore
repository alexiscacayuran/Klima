# Local environment. .env.development and .env.production carry the CIS bearer
# token that docker-compose.yml hands to each service, so every env file here is
# a credential file. Nothing env-shaped is committed — the variables are
# documented in the files themselves, and in the two things that read them:
# client/vite.config.ts and client/nginx.conf.template.
.env
.env.*

# Playwright. The browsers live in ~/.cache/ms-playwright, not here; these are
# only the per-run artefacts — reports, traces, and the screenshots the station
# tests write on the way past.
client/test-results/
client/playwright-report/
client/blob-report/
client/e2e/__screenshots__/
