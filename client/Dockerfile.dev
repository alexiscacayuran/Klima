# syntax=docker/dockerfile:1

# Development image: runs the Vite dev server with HMR.
# Source is bind-mounted at runtime (see docker-compose.yml), so nothing is COPYed
# beyond the manifests needed to install node_modules into the image.
FROM node:24-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 5173

CMD ["npm", "run", "dev"]
